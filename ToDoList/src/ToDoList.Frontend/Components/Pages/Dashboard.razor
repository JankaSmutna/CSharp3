@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

<div>
    <h2>ToDo items dashboard</h2>
    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th><button class="btn btn-secondary" @onclick="OrderById">Sort by Id</button></th>
                <th><button class="btn btn-primary" @onclick="OrderByName">Sort by Name</button></th>
                <th>Description</th>
                <th>IsCompleted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="@GetRowClass(item)">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Yes" : "No")</td>
                    <td>
                        <button class="btn btn-success" @onclick="() => ToggleCompleted(item)">
                            @(item.IsCompleted ? "Mark Incomplete" : "Mark Complete")
                        </button>
                        <button class="btn btn-warning" @onclick="() => EditItem(item)">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button class="btn btn-danger" @onclick="() => DeleteItem(item)" title="Delete Item">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ToDoItemView> sortedData = new();

    public void OrderByName()
    {
        sortedData = sortedData.OrderBy(item => item.Name).ToList();
    }

    public void OrderById()
    {
        sortedData = sortedData.OrderBy(item => item.Id).ToList();
    }

    public async Task ToggleCompleted(ToDoItemView item)
    {
        item.IsCompleted = !item.IsCompleted;

        await toDoItemsClient.UpdateItemAsync(item);

        sortedData = await toDoItemsClient.ReadItemsAsync();

        StateHasChanged();
    }

    private string GetRowClass(ToDoItemView item)
    {
        return item.IsCompleted ? "table-success" : "table-light";
    }

    public void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"editToDoItem/{toDoItem.Id}");
    }

    public async Task DeleteItem(ToDoItemView item)
    {
        await toDoItemsClient.DeleteItemAsync(item.Id);

        sortedData = await toDoItemsClient.ReadItemsAsync();

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }
}
